<div class="container" style="padding: 6rem 1.5rem 4rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; align-items: center; background: var(--color-bg-card); padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
    <div>
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="border-radius: var(--radius-md); width: 100%;">
      {% endif %}
    </div>
    <div>
      <h1 style="font-family: var(--font-display); font-size: 3rem; letter-spacing: 1px; margin-bottom: 0.5rem;">{{ product.title }}</h1>
      <p style="font-size: 1.8rem; font-weight: 800; color: var(--color-accent-gold); margin-bottom: 1.5rem;">{{ product.price | money }}</p>
      <div style="color: var(--color-text-sub); line-height: 1.7; margin-bottom: 2rem;">{{ product.description }}</div>

      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" class="btn btn-primary btn-glow btn-lg" style="width: 100%; justify-content: center;">
          <i class="fa-solid fa-plus"></i> Add to Order • {{ product.price | money }}
        </button>
      </form>
    </div>
  </div>
</div>
