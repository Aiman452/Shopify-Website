<div class="container" style="padding: 6rem 1.5rem 4rem; max-width: 800px;">
  <div style="background: var(--color-bg-card); padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
    <h1 style="font-family: var(--font-display); font-size: 2.8rem; margin-bottom: 1.5rem; text-align: center;">YOUR DIRECT ORDER</h1>
    
    {% if cart.item_count == 0 %}
      <div style="text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-bag-shopping" style="font-size: 3rem; color: var(--color-text-muted); margin-bottom: 1rem;"></i>
        <p style="color: var(--color-text-sub); margin-bottom: 1.5rem;">Your cart is currently empty.</p>
        <a href="/" class="btn btn-primary btn-glow">Explore The Menu</a>
      </div>
    {% else %}
      <form action="/cart" method="post">
        {% for item in cart.items %}
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid var(--color-border);">
            <div style="display: flex; align-items: center; gap: 1rem;">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 80 }}" alt="{{ item.title | escape }}" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;">
              {% endif %}
              <div>
                <h3 style="font-size: 1.1rem; margin-bottom: 0.2rem;">{{ item.product.title }}</h3>
                <span style="color: var(--color-accent-gold); font-weight: 700;">{{ item.price | money }}</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <span style="font-weight: 700;">Qty: {{ item.quantity }}</span>
              <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #e63946;"><i class="fa-solid fa-trash-can"></i></a>
            </div>
          </div>
        {% endfor %}

        <div style="margin-top: 2rem; display: flex; justify-content: space-between; align-items: center; font-size: 1.3rem; font-weight: 800;">
          <span>Total:</span>
          <span style="color: var(--color-accent-gold);">{{ cart.total_price | money }}</span>
        </div>

        <a href="/checkout" class="btn btn-primary btn-block btn-glow btn-lg" style="margin-top: 1.5rem; text-align: center; justify-content: center;">
          <i class="fa-solid fa-lock"></i> Proceed to Secure Checkout
        </a>
      </form>
    {% endif %}
  </div>
</div>
