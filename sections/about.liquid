<!-- Our Story Section -->
<section class="about-section" id="about">
  <div class="container about-grid">
    <div class="about-visual">
      <div class="about-image-card">
        <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=900&q=80" alt="Fresh Smash Burger and Fries" class="about-img">
        <div class="about-experience-badge">
          <span class="exp-number">100%</span>
          <span class="exp-text">Authentic Chicago Tradition</span>
        </div>
      </div>
    </div>

    <div class="about-text-content">
      <span class="section-tag"><i class="fa-solid fa-heart text-red"></i> BORN IN THE WINDY CITY</span>
      <h2 class="section-title">BRINGING CHICAGO'S STREET ROOTS TO TAMPA</h2>
      <p class="lead-text">
        At Chicago Paulie's, we don't cut corners. We believe a real Chicago hot dog must be dragged through the garden—yellow mustard, neon relish, chopped onions, tomato wedges, pickle spear, sport peppers, and a dash of celery salt on a steamed S. Rosen's poppy seed bun.
      </p>
      <p>
        Our Italian beef is slow-roasted for hours with proprietary herbs, thinly sliced, and piled high into Turano rolls dipped in savory au jus gravy. Whether you like it "Sweet", "Hot", or "Juicy", we bring you the authentic taste that locals crave.
      </p>

      <div class="about-checklist">
        <div class="check-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>No Ketchup on Hot Dogs (Chicago Rule #1!)</span>
        </div>
        <div class="check-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Slow-Cooked Seasoned Au Jus Gravy Daily</span>
        </div>
        <div class="check-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Fresh Smashed USDA Choice Beef Patties</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Section",
  "settings": []
}
{% endschema %}
