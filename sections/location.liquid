<!-- Location & Hours Section -->
<section class="location-section" id="location">
  <div class="container location-grid">
    <div class="location-info-card">
      <span class="section-tag"><i class="fa-solid fa-map-pin text-red"></i> VISIT US IN TAMPA</span>
      <h2 class="section-title">LOCATION & HOURS</h2>
      
      <div class="info-list">
        <div class="info-item">
          <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
          <div>
            <h4>Address</h4>
            <p>1301 N Howard Ave, Tampa, FL 33607</p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon"><i class="fa-solid fa-clock"></i></div>
          <div>
            <h4>Opening Hours</h4>
            <p class="hours-status">
              <span class="status-indicator-open"></span> <strong>Open Today: 11:00 AM – 9:00 PM</strong>
            </p>
            <span class="hours-sub">Tuesday – Sunday: 11:00 AM – 9:00 PM • Monday: Closed</span>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
          <div>
            <h4>Direct Call</h4>
            <p><a href="tel:8135550192" class="phone-link">(813) 555-0192</a></p>
          </div>
        </div>
      </div>

      <div class="location-actions">
        <a href="https://maps.google.com/?q=1301+N+Howard+Ave+Tampa+FL" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">
          <i class="fa-solid fa-diamond-turn-right"></i> Open in Google Maps
        </a>
        <a href="tel:8135550192" class="btn btn-glass">
          <i class="fa-solid fa-phone-volume"></i> Call To Order
        </a>
      </div>
    </div>

    <div class="map-container">
      <div class="map-placeholder-card">
        <i class="fa-solid fa-map-location-dot map-bg-icon"></i>
        <div class="map-pin-badge">
          <span class="chicago-star">★</span>
          <strong>Chicago Paulie's</strong>
          <span>1301 N Howard Ave, Tampa</span>
        </div>
        <a href="https://maps.google.com/?q=1301+N+Howard+Ave+Tampa+FL" target="_blank" rel="noopener noreferrer" class="map-overlay-btn btn btn-primary">
          <i class="fa-solid fa-location-arrow"></i> View Live Directions
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Location Section",
  "settings": []
}
{% endschema %}
