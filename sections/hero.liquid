<!-- Hero Section -->
<section class="hero-section" id="hero">
  <div class="hero-bg-overlay"></div>
  <div class="container hero-content">
    <div class="hero-text-block">
      <div class="hero-pill">
        <span class="pulsing-dot"></span>
        <span>Authentic Chicago Street Food in Tampa</span>
      </div>
      <h1 class="hero-title">
        LEGENDARY FLAVORS.<br>
        <span class="text-gradient">PURE CHICAGO SOUL.</span>
      </h1>
      <p class="hero-subtitle">
        Real Vienna Beef dragged through the garden, slow-roasted Italian beef drenched in au jus gravy, and crispy smash burgers served piping hot on N Howard Ave.
      </p>

      <div class="hero-cta-group">
        <a href="#menu" class="btn btn-lg btn-primary btn-glow">
          <i class="fa-solid fa-utensils"></i> Explore The Menu
        </a>
        <a href="#location" class="btn btn-lg btn-glass">
          <i class="fa-solid fa-location-arrow"></i> Get Directions
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat-item">
          <div class="stat-rating">
            <span class="stat-num">4.9</span>
            <div class="stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
          </div>
          <span class="stat-label">500+ Google Reviews</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">100%</span>
          <span class="stat-label">Vienna Beef Certified</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">0%</span>
          <span class="stat-label">3rd Party Commission Fees</span>
        </div>
      </div>
    </div>

    <div class="hero-visual-block">
      <div class="hero-image-wrapper">
        <img src="https://images.unsplash.com/photo-1619740455993-9e612b1af08a?auto=format&fit=crop&w=1000&q=80" alt="Chicago Style Hot Dog" class="hero-main-img" id="heroFeaturedImg">
        
        <!-- Floating highlight badges -->
        <div class="floating-badge badge-top-right">
          <i class="fa-solid fa-pepper-hot text-red"></i>
          <div>
            <strong>Spicy Giardiniera</strong>
            <span>House-made recipe</span>
          </div>
        </div>

        <div class="floating-badge badge-bottom-left">
          <i class="fa-solid fa-crown text-gold"></i>
          <div>
            <strong>Tampa's Favorite</strong>
            <span>Dipped Italian Beef</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": []
}
{% endschema %}
