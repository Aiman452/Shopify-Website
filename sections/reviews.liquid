<!-- Google Reviews Section -->
<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-header">
      <span class="section-tag"><i class="fa-solid fa-star text-gold"></i> REAL CUSTOMER LOVE</span>
      <h2 class="section-title">4.9 STARS ACROSS 500+ REVIEWS</h2>
      <p class="section-desc">See why Tampa locals and Chicago transplants call us their favorite comfort spot.</p>
    </div>

    <div class="reviews-grid">
      <div class="review-card">
        <div class="review-header">
          <div class="stars text-gold">
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          </div>
          <span class="google-badge"><i class="fa-brands fa-google"></i> Verified</span>
        </div>
        <p class="review-text">
          "I moved from Chicago 4 years ago and haven't found real Italian beef until I tried Paulie's. The giardiniera has the perfect kick and getting it dipped is pure bliss. Best in Florida hands down!"
        </p>
        <div class="reviewer-info">
          <div class="reviewer-avatar">MR</div>
          <div>
            <h4>Marcus R.</h4>
            <span>Tampa Local • 2 weeks ago</span>
          </div>
        </div>
      </div>

      <div class="review-card featured-review">
        <div class="review-header">
          <div class="stars text-gold">
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          </div>
          <span class="google-badge"><i class="fa-brands fa-google"></i> Verified</span>
        </div>
        <p class="review-text">
          "The smash burger is insanely juicy with those crispy lace edges, and the crinkle fries seasoned with cheese sauce are addictive. Fast service, super friendly team. 10/10 recommend!"
        </p>
        <div class="reviewer-info">
          <div class="reviewer-avatar">SL</div>
          <div>
            <h4>Sarah L.</h4>
            <span>Local Guide • 1 month ago</span>
          </div>
        </div>
      </div>

      <div class="review-card">
        <div class="review-header">
          <div class="stars text-gold">
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          </div>
          <span class="google-badge"><i class="fa-brands fa-google"></i> Verified</span>
        </div>
        <p class="review-text">
          "Authentic Vienna beef hot dog dragged through the garden with celery salt and poppyseed bun. You can't fake this quality. Tampa needed this!"
        </p>
        <div class="reviewer-info">
          <div class="reviewer-avatar">DK</div>
          <div>
            <h4>Dave K.</h4>
            <span>Foodie • 3 weeks ago</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Section",
  "settings": []
}
{% endschema %}
