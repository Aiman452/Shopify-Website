<!-- Top Announcement Bar -->
<div class="top-announcement-bar">
  <div class="container top-bar-content">
    <span><i class="fa-solid fa-star text-gold"></i> <strong>{{ section.settings.announcement | default: "4.9 ★ Rating (500+ Google Reviews) — Tampa's #1 Authentic Chicago Spot!" }}</strong></span>
    <div class="top-bar-contact">
      <a href="tel:8135550192"><i class="fa-solid fa-phone"></i> (813) 555-0192</a>
      <span>•</span>
      <span><i class="fa-solid fa-location-dot"></i> 1301 N Howard Ave, Tampa, FL</span>
    </div>
  </div>
</div>

<!-- Header / Navigation -->
<header class="site-header" id="mainHeader">
  <div class="container header-container">
    <a href="/" class="brand-logo">
      <div class="logo-badge">
        <span class="chicago-star">★</span>
        <span class="chicago-star">★</span>
      </div>
      <div class="brand-text">
        <span class="brand-main">CHICAGO PAULIE'S</span>
        <span class="brand-sub">TAMPA, FLORIDA • EST. CLASSIC</span>
      </div>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="#menu" class="nav-link">Menu</a>
      <a href="#about" class="nav-link">Our Story</a>
      <a href="#reviews" class="nav-link">Reviews</a>
      <a href="#catering" class="nav-link">Catering</a>
      <a href="#location" class="nav-link">Hours & Location</a>
    </nav>

    <div class="header-actions">
      <button class="cart-btn" id="cartToggleBtn" aria-label="View Cart">
        <i class="fa-solid fa-bag-shopping"></i>
        <span class="cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
      </button>
      <a href="#menu" class="btn btn-primary btn-glow">
        <i class="fa-solid fa-fire"></i> Order Online
      </a>
      <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement Text",
      "default": "4.9 ★ Rating (500+ Google Reviews) — Tampa's #1 Authentic Chicago Spot!"
    }
  ]
}
{% endschema %}
